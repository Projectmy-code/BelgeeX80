<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Новый пароль — BELGEE X80</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class', theme: { extend: { colors: { brand: { teal: '#00f0ff', dark: '#0c1017', card: '#161e2b', border: '#253142' } } } } }
    </script>
    <style> body { background-color: #0c1017; color: white; font-family: sans-serif; } </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
    <div class="bg-brand-card w-full max-w-md p-8 rounded-3xl border border-brand-border shadow-2xl">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold mb-2">Установка пароля</h1>
            <p class="text-gray-400 text-sm">Придумайте новый пароль для вашего аккаунта</p>
        </div>

        <form id="update-form" class="space-y-4">
            <div>
                <label class="block text-xs text-gray-400 mb-1">Новый пароль</label>
                <input type="password" id="new-password" required minlength="6" class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-sm text-white focus:border-brand-teal focus:outline-none">
            </div>
            <div>
                <label class="block text-xs text-gray-400 mb-1">Повторите пароль</label>
                <input type="password" id="confirm-password" required minlength="6" class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-sm text-white focus:border-brand-teal focus:outline-none">
            </div>
            
            <div id="error-msg" class="text-red-400 text-xs hidden"></div>
            <div id="success-msg" class="text-emerald-400 text-xs hidden"></div>

            <button type="submit" id="submit-btn" class="w-full py-3 bg-brand-teal text-black font-bold rounded-xl hover:opacity-90 transition-all">Сохранить пароль</button>
        </form>
    </div>

    <script type="module">
        import { supabase } from './js/config.js';

        const form = document.getElementById('update-form');
        const errorMsg = document.getElementById('error-msg');
        const successMsg = document.getElementById('success-msg');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const pass = document.getElementById('new-password').value;
            const confirm = document.getElementById('confirm-password').value;
            const btn = document.getElementById('submit-btn');

            if (pass !== confirm) {
                errorMsg.textContent = 'Пароли не совпадают!';
                errorMsg.classList.remove('hidden');
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Сохранение...';
            errorMsg.classList.add('hidden');

            // Обновляем пароль пользователя
            const { error } = await supabase.auth.updateUser({ password: pass });

            btn.disabled = false;
            btn.textContent = 'Сохранить пароль';

            if (error) {
                errorMsg.textContent = 'Ошибка: ' + error.message;
                errorMsg.classList.remove('hidden');
            } else {
                successMsg.textContent = 'Пароль успешно изменен! Перенаправляем на главную...';
                successMsg.classList.remove('hidden');
                form.reset();
                setTimeout(() => { window.location.href = 'index.html'; }, 2000);
            }
        });
    </script>
</body>
</html>
